# ============================================================== API keys ====
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
# Only needed when NORMALIZER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only needed when NORMALIZER_PROVIDER=gemini
GEMINI_API_KEY=

# ============================================================== server =====
HOST=127.0.0.1
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=512
LOG_LEVEL=INFO

# ================================================================= VAD =====
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=200
VAD_MIN_SILENCE_MS=180
# Padding around every speech boundary (spec: 50-80 ms)
VAD_PAD_MS=65
VAD_MERGE_GAP_MS=120

# ================================================================= ASR =====
GROQ_ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=az
ASR_CHUNK_SECONDS=420

# ================================================== LLM (terms + B-roll) ===
# gemini | groq | anthropic | agy | off
NORMALIZER_PROVIDER=groq
GEMINI_MODEL=gemini-2.5-flash
GROQ_LLM_MODEL=qwen/qwen3.6-27b
GROQ_LLM_FALLBACKS=groq/compound,openai/gpt-oss-120b,openai/gpt-oss-20b
ANTHROPIC_MODEL=claude-sonnet-5

# ============================================================== B-roll =====
BROLL_MIN_SUGGESTIONS=2
BROLL_MAX_SUGGESTIONS=3
BROLL_SEARCH_RESULTS=8
BROLL_DEFAULT_DURATION=3.0
BROLL_MAX_DURATION=5.0

# ============================================================ timeline =====
CUT_PAD_MS=40
MIN_REMOVABLE_GAP_MS=120
MIN_CLIP_MS=120
# Also cut VAD-detected dead air inside surviving passages
TRIM_SILENCES=true
SILENCE_TRIM_MS=350

# ============================================================== render =====
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
VIDEO_CRF=18
VIDEO_PRESET=medium
AUDIO_BITRATE=192k
AUDIO_FADE_MS=12
AUDIO_CROSSFADE_MS=24
AUDIO_JOIN_MODE=crossfade

# =========================================================== subtitles =====
# auto | ass | pillow (auto picks .ass when FFmpeg has libass)
SUBTITLE_ENGINE=auto
SUBTITLE_FONT_FAMILY=Montserrat ExtraBold
SUBTITLE_FONT_FILE=
SUBTITLE_FONT_SIZE=112
SUBTITLE_BASE_COLOR=#FFFFFF
SUBTITLE_HIGHLIGHT_COLOR=#FFE94D
SUBTITLE_OUTLINE_COLOR=#000000
SUBTITLE_OUTLINE_WIDTH=11
SUBTITLE_SHADOW_OFFSET=6
SUBTITLE_POSITION=lower_third
SUBTITLE_MAX_WORDS_PER_LINE=3
SUBTITLE_MAX_CHARS_PER_LINE=18
SUBTITLE_UPPERCASE=false
